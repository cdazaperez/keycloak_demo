<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Keycloak Demo</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f0f2f5; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
    .container { background: white; padding: 3rem; border-radius: 12px; box-shadow: 0 2px 20px rgba(0,0,0,0.1); text-align: center; max-width: 480px; width: 90%; }
    h1 { color: #1a1a2e; margin-bottom: 0.5rem; font-size: 2rem; }
    .subtitle { color: #666; margin-bottom: 2rem; }
    .btn { display: inline-block; padding: 12px 32px; background: #4e73df; color: white; text-decoration: none; border-radius: 8px; font-size: 1rem; transition: background 0.2s; }
    .btn:hover { background: #3a5bc7; }
    .user-info { background: #e8f5e9; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; }
    .links a { margin: 0 0.5rem; color: #4e73df; text-decoration: none; }
    .error { background: #fde8e8; color: #c62828; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; }
    .logo { font-size: 3rem; margin-bottom: 1rem; }
  </style>
</head>
<body>
  <div class="container">
    <div class="logo">&#128272;</div>
    <h1>Keycloak Demo</h1>
    <p class="subtitle">Autenticacion con OpenID Connect</p>

    <% if (typeof user !== 'undefined' && user) { %>
      <div class="user-info">
        <p>Bienvenido, <strong><%= user.name %></strong></p>
      </div>
      <div class="links">
        <a href="/profile" class="btn">Mi Perfil</a>
        <a href="/logout" class="btn" style="background:#e74c3c;">Cerrar Sesion</a>
      </div>
    <% } else { %>
      <a href="/login" class="btn">Iniciar Sesion con Keycloak</a>
    <% } %>
  </div>
</body>
</html>
